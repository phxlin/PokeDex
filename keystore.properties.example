# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Without keystore.properties, release builds fall back to the debug key.
#
# Create a keystore once, and keep it (and its passwords) somewhere safe:
#   keytool -genkeypair -v -keystore pokedex-release.jks -alias pokedex \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved from the project root; an absolute path works too.
storeFile=pokedex-release.jks
storePassword=changeme
keyAlias=pokedex
keyPassword=changeme
